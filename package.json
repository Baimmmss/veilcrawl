{
  "name": "veilcrawl",
  "version": "0.2.0",
  "description": "Direct-search & blindfolded headless-browser web engine for AI agents (MCP + CLI)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Baimmmss/veilcrawl.git"
  },
  "homepage": "https://github.com/Baimmmss/veilcrawl#readme",
  "bugs": "https://github.com/Baimmmss/veilcrawl/issues",
  "keywords": [
    "mcp",
    "mcp-server",
    "ai-agents",
    "crawler",
    "search",
    "semantic-search",
    "privacy",
    "redaction",
    "lightpanda",
    "playwright"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "veilcrawl": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "VEILCRAWL_SEMANTIC=off node --test --test-concurrency=1 'tests/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.2.0",
    "playwright": "^1.65.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^3.8.1"
  },
  "overrides": {
    "sharp": "^0.35.4"
  }
}
